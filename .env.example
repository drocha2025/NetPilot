@"
NETPILOT_DB_NAME=netpilot
# Defines the PostgreSQL database name.

NETPILOT_DB_USER=netpilot_app
# Defines the PostgreSQL application username.

NETPILOT_DB_PASSWORD=NetPilotDB2026!
# Provides a placeholder that must be replaced by the engineer's local password.
"@ | Set-Content ".\.env.example"
# Creates the example environment configuration without storing a real secret.